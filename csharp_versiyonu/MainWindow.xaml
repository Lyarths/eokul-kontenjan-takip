<Window x:Class="EOkulKontenjanTakip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="e-Okul Kontenjan Takip"
        Icon="pack://application:,,,/Assets/logo.ico"
        Width="980" Height="690"
        MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ÜST NAVİGASYON BARI -->
        <Border Grid.Row="0"
                Background="{DynamicResource TopBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: Logo ve Başlık -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="9"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}"
                            BorderThickness="1" Margin="0,0,12,0" Padding="4">
                        <Image Source="pack://application:,,,/Assets/logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="e-Okul Kontenjan Takip" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ActiveEngineSubtitle" Text="Düz İstek (HTTP / cURL)" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Orta: Sekmeler -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource CardInnerBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabListBtn" Style="{StaticResource NavTabButtonStyle}" IsChecked="True" Checked="NavTab_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Okullarım" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="7,1" Margin="7,0,0,0">
                                    <TextBlock x:Name="SchoolCountBadgeText" Text="0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabAddBtn" Content="Okul Ekle" Style="{StaticResource NavTabButtonStyle}" Checked="NavTab_Checked" Margin="4,0"/>
                        <RadioButton x:Name="TabSettingsBtn" Content="Ayarlar" Style="{StaticResource NavTabButtonStyle}" Checked="NavTab_Checked"/>
                    </StackPanel>
                </Border>

                <!-- Sağ: Zamanlayıcı, Yenile, Tema -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource CardInnerBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TimerBadgeText" Text="60:00" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>

                    <Button x:Name="RefreshAllBtn" Content="Şimdi Yenile" Style="{StaticResource PrimaryButtonStyle}" Click="RefreshAllBtn_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ThemeToggleBtn" Content="Koyu Tema" Style="{StaticResource FluentButtonStyle}" Click="ThemeToggleBtn_Click" Padding="11,7"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ANA İÇERİK ALANI -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16,24,16">
            <Grid MaxWidth="880" HorizontalAlignment="Stretch">

                <!-- GÖRÜNÜM 1: OKULLARIM -->
                <StackPanel x:Name="ViewListPanel" Visibility="Visible">
                    <Border x:Name="EmptyListCard"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderHoverBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="32,46"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Henüz takip edilen okul yok" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Takip etmek istediğiniz liseyi ekleyerek boş kontenjanları otomatik izleyebilirsiniz."
                                       FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,18" HorizontalAlignment="Center"/>
                            <Button Content="Okul Ekle" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Click="GoToAddTab_Click"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="SchoolsStackPanel"/>
                </StackPanel>

                <!-- GÖRÜNÜM 2: OKUL EKLE (Sıkışıklık Giderilmiş, Adım Adım Yönlendirmeli Düzen) -->
                <Border x:Name="ViewAddPanel" Visibility="Collapsed"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="22,18">
                    <StackPanel>
                        <!-- Başlık -->
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Takip Listesine Okul Ekle" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Adımları sırasıyla seçin. Açılan kutularda klavyeyle doğrudan arama yapabilirsiniz." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="ReloadGmBtn" Content="Listeyi Yenile" Style="{StaticResource FluentButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="11,5" FontSize="12" Click="ReloadGmBtn_Click"/>
                        </Grid>

                        <!-- ADIM 1: Okul Türü (Genel Müdürlük) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border x:Name="Step1Badge" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource AccentBrush}" Margin="0,0,7,0">
                                <Grid>
                                    <TextBlock x:Name="Step1BadgeText" Text="1" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Path x:Name="Step1CheckIcon" Data="M 2,6.5 L 5,9.5 L 11,3" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="Lise Türünü Seçin" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <UniformGrid x:Name="GmCardsGrid" Columns="3" Margin="0,0,0,12"/>

                        <!-- ADIM 2 ve ADIM 3: İl ve İlçe -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ADIM 2: İL -->
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border x:Name="Step2Badge" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource BorderHoverBrush}" Margin="0,0,7,0">
                                        <Grid>
                                            <TextBlock x:Name="Step2BadgeText" Text="2" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Path x:Name="Step2CheckIcon" Data="M 2,6.5 L 5,9.5 L 11,3" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="İl Seçimi" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid x:Name="IlPickerHost">
                                    <Button x:Name="IlPickerBtn" Style="{StaticResource FluentButtonStyle}" IsEnabled="False" HorizontalContentAlignment="Stretch" Padding="12,8" Click="IlPickerBtn_Click">
                                        <Grid>
                                            <TextBlock x:Name="IlPickerBtnText" Text="Önce 1. adımdan lise türü seçin" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,18,0"/>
                                            <Path Data="M 3.5,6 L 8,10.2 L 12.5,6" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <Popup x:Name="IlPopup" PlacementTarget="{Binding ElementName=IlPickerBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Width="{Binding ActualWidth, ElementName=IlPickerBtn}"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1.5" CornerRadius="10" Margin="0,4,0,0" Padding="6">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBox x:Name="IlSearchBox"
                                                             Background="{DynamicResource CardInnerBrush}"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                             BorderBrush="{DynamicResource BorderBrush}"
                                                             Padding="28,6,8,6" FontSize="13"
                                                             TextChanged="IlSearchBox_TextChanged"/>
                                                    <Path Data="M 6.8,2.2 A 4.6,4.6 0 1 0 6.8,11.4 A 4.6,4.6 0 1 0 6.8,2.2 Z M 10.2,10.2 L 13.8,13.8"
                                                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                                                    <TextBlock Text="İl adı yazarak arayın..." IsHitTestVisible="False"
                                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="29,0,0,0" VerticalAlignment="Center"
                                                               Visibility="{Binding Text.IsEmpty, ElementName=IlSearchBox, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                                <ListBox x:Name="IlOptionsList" MaxHeight="200" BorderThickness="0" Background="Transparent"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                                         SelectionChanged="IlOptionsList_SelectionChanged"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <!-- ADIM 3: İLÇE -->
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border x:Name="Step3Badge" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource BorderHoverBrush}" Margin="0,0,7,0">
                                        <Grid>
                                            <TextBlock x:Name="Step3BadgeText" Text="3" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Path x:Name="Step3CheckIcon" Data="M 2,6.5 L 5,9.5 L 11,3" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="İlçe Seçimi" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid x:Name="IlcePickerHost">
                                    <Button x:Name="IlcePickerBtn" Style="{StaticResource FluentButtonStyle}" IsEnabled="False" HorizontalContentAlignment="Stretch" Padding="12,8" Click="IlcePickerBtn_Click">
                                        <Grid>
                                            <TextBlock x:Name="IlcePickerBtnText" Text="Önce 2. adımdan il seçin" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,18,0"/>
                                            <Path Data="M 3.5,6 L 8,10.2 L 12.5,6" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <Popup x:Name="IlcePopup" PlacementTarget="{Binding ElementName=IlcePickerBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Width="{Binding ActualWidth, ElementName=IlcePickerBtn}"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1.5" CornerRadius="10" Margin="0,4,0,0" Padding="6">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBox x:Name="IlceSearchBox"
                                                             Background="{DynamicResource CardInnerBrush}"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                             BorderBrush="{DynamicResource BorderBrush}"
                                                             Padding="28,6,8,6" FontSize="13"
                                                             TextChanged="IlceSearchBox_TextChanged"/>
                                                    <Path Data="M 6.8,2.2 A 4.6,4.6 0 1 0 6.8,11.4 A 4.6,4.6 0 1 0 6.8,2.2 Z M 10.2,10.2 L 13.8,13.8"
                                                          Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                                                    <TextBlock Text="İlçe adı yazarak arayın..." IsHitTestVisible="False"
                                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="29,0,0,0" VerticalAlignment="Center"
                                                               Visibility="{Binding Text.IsEmpty, ElementName=IlceSearchBox, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                                <ListBox x:Name="IlceOptionsList" MaxHeight="200" BorderThickness="0" Background="Transparent"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                                         SelectionChanged="IlceOptionsList_SelectionChanged"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- ADIM 4: OKUL SEÇİMİ -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border x:Name="Step4Badge" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource BorderHoverBrush}" Margin="0,0,7,0">
                                <Grid>
                                    <TextBlock x:Name="Step4BadgeText" Text="4" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Path x:Name="Step4CheckIcon" Data="M 2,6.5 L 5,9.5 L 11,3" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="Okul Seçimi" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid x:Name="OkulPickerHost" Margin="0,0,0,12">
                            <Button x:Name="OkulPickerBtn" Style="{StaticResource FluentButtonStyle}" IsEnabled="False" HorizontalContentAlignment="Stretch" Padding="12,8" Click="OkulPickerBtn_Click">
                                <Grid>
                                    <TextBlock x:Name="OkulPickerBtnText" Text="Önce 3. adımdan ilçe seçin" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,18,0"/>
                                    <Path Data="M 3.5,6 L 8,10.2 L 12.5,6" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Popup x:Name="OkulPopup" PlacementTarget="{Binding ElementName=OkulPickerBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, ElementName=OkulPickerBtn}"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1.5" CornerRadius="10" Margin="0,4,0,0" Padding="6">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBox x:Name="OkulSearchBox"
                                                     Background="{DynamicResource CardInnerBrush}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}"
                                                     Padding="28,6,8,6" FontSize="13"
                                                     TextChanged="OkulSearchBox_TextChanged"/>
                                            <Path Data="M 6.8,2.2 A 4.6,4.6 0 1 0 6.8,11.4 A 4.6,4.6 0 1 0 6.8,2.2 Z M 10.2,10.2 L 13.8,13.8"
                                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                                            <TextBlock Text="Lise adı veya kurum kodu yazarak arayın..." IsHitTestVisible="False"
                                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="29,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding Text.IsEmpty, ElementName=OkulSearchBox, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                        <ListBox x:Name="OkulOptionsList" MaxHeight="210" BorderThickness="0" Background="Transparent"
                                                 Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                                 SelectionChanged="OkulOptionsList_SelectionChanged"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- ADIM 5: BİLDİRİM ALINACAK SINIFLAR -->
                        <TextBlock Text="Bildirim Alınacak Sınıflar (Tıklayarak Açıp Kapatabilirsiniz)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <UniformGrid Columns="4" Margin="0,0,0,12">
                            <CheckBox x:Name="CbGrade9" Content="9. Sınıf" Style="{StaticResource GradePillCheckStyle}" IsChecked="True" Margin="0,0,8,0"/>
                            <CheckBox x:Name="CbGrade10" Content="10. Sınıf" Style="{StaticResource GradePillCheckStyle}" IsChecked="True" Margin="0,0,8,0"/>
                            <CheckBox x:Name="CbGrade11" Content="11. Sınıf" Style="{StaticResource GradePillCheckStyle}" IsChecked="True" Margin="0,0,8,0"/>
                            <CheckBox x:Name="CbGrade12" Content="12. Sınıf" Style="{StaticResource GradePillCheckStyle}" IsChecked="True"/>
                        </UniformGrid>

                        <!-- Durum / Uyarı Çubuğu (Tam Butonun Hemen Üstünde Görünür!) -->
                        <Border x:Name="AddStatusBorder"
                                Background="{DynamicResource CardInnerBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                            <TextBlock x:Name="AddStatusText" Text="1. adımdan lise türünü seçerek başlayın." FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </Border>

                        <Button Content="Takip Listesine Ekle ve Şimdi Sorgula" Style="{StaticResource PrimaryButtonStyle}" Padding="14,10" Click="AddSchoolSubmitBtn_Click"/>
                    </StackPanel>
                </Border>

                <!-- GÖRÜNÜM 3: AYARLAR -->
                <StackPanel x:Name="ViewSettingsPanel" Visibility="Collapsed">
                    <!-- Sorgu Yöntemi Kartı -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Sorgu Yöntemi" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="e-Okul kontenjan bilgilerinin hangi yöntemle kontrol edileceğini seçin." FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Seçenek 1: Düz İstek (HTTP / cURL) -->
                                <Border x:Name="EngineHttpCard" Grid.Column="0" CornerRadius="10" Padding="15,12" Cursor="Hand" BorderThickness="1.5" MouseLeftButtonUp="EngineHttpCard_Click">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="Düz İstek (HTTP / cURL)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Border Background="{DynamicResource GreenSoftBrush}" CornerRadius="8" Padding="7,2" HorizontalAlignment="Right">
                                                <TextBlock Text="Varsayılan • Önerilen" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource GreenBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Tarayıcı açmadan doğrudan e-Okul sunucusuna hafif HTTP paketleri gönderir. Çok hızlıdır (~3 sn), RAM tüketmez ve ek kurulum gerektirmez."
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Seçenek 2: Chromium Tarayıcı -->
                                <Border x:Name="EngineChromiumCard" Grid.Column="2" CornerRadius="10" Padding="15,12" Cursor="Hand" BorderThickness="1.5" MouseLeftButtonUp="EngineChromiumCard_Click">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,5">
                                            <TextBlock Text="Chromium Tarayıcı" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Border x:Name="ChromiumInstallBadge" Background="{DynamicResource AmberSoftBrush}" CornerRadius="8" Padding="7,2" HorizontalAlignment="Right">
                                                <TextBlock x:Name="ChromiumInstallBadgeText" Text="İndirme Gerekir (~105 MB)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AmberBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Arka planda gizli bir Chromium tarayıcısı başlatarak sayfayı gerçek bir kullanıcı gibi tıklar. Seçildiğinde %LOCALAPPDATA%\E-Okul Checker\chromium klasörüne (~105 MB) indirilir ve kurulur."
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="ChromiumPathText" Text="Kurulum Yolu: -" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,8"/>

                                        <!-- Canlı İndirme Çubuğu (MB / Toplam MB Gösterimli) -->
                                        <StackPanel x:Name="ChromiumProgressPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock x:Name="ChromiumProgressLabel" Text="İndiriliyor: 0.0 MB / 105.0 MB (%0)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Grid>
                                            <ProgressBar x:Name="ChromiumProgressBar" Minimum="0" Maximum="100" Value="0" Height="8"
                                                         Background="{DynamicResource BorderBrush}"
                                                         Foreground="{DynamicResource AccentBrush}"
                                                         BorderThickness="0"/>
                                        </StackPanel>

                                        <!-- Chromium İndir / Klasörü Aç Butonları -->
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="DownloadChromiumBtn" Style="{StaticResource PrimaryButtonStyle}" Padding="11,5" FontSize="11.5" Margin="0,0,8,0" Click="DownloadChromiumBtn_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M 8,2 V 10.5 M 4.5,7.5 L 8,11 L 11.5,7.5 M 2.5,13.5 H 13.5" Stroke="#FFFFFF" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="DownloadChromiumBtnText" Text="Chromium'u İndir ve Kur" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource FluentButtonStyle}" Padding="10,5" FontSize="11.5" Click="OpenChromiumFolderBtn_Click" ToolTip="%LOCALAPPDATA%\E-Okul Checker\chromium klasörünü açar">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M 1.5,3.5 H 6 L 7.5,5.2 H 14.5 V 13 H 1.5 Z" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Klasörü Aç" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Kontrol ve Bildirim Tercihleri -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="22,18">
                        <StackPanel>
                            <TextBlock Text="Kontrol ve Bildirim Ayarları" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Otomatik Kontrol Sıklığı" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Arka planda okulların ne sıklıkla otomatik sorgulanacağı" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <ComboBox x:Name="IntervalComboBox" Width="190" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,6" SelectionChanged="IntervalComboBox_SelectionChanged">
                                    <ComboBoxItem Content="5 Dakika" Tag="300"/>
                                    <ComboBoxItem Content="15 Dakika" Tag="900"/>
                                    <ComboBoxItem Content="30 Dakika" Tag="1800"/>
                                    <ComboBoxItem Content="1 Saat (Varsayılan)" Tag="3600"/>
                                    <ComboBoxItem Content="2 Saat" Tag="7200"/>
                                </ComboBox>
                            </Grid>

                            <CheckBox x:Name="ChkWinNotify" Content="Windows Bildirimleri (Sağ alt sistem bildirimi)" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>
                            <CheckBox x:Name="ChkPopupNotify" Content="Uygulama İçi Uyarı Penceresi (Standart bildirim kutusu)" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>
                            <CheckBox x:Name="ChkFlashNotify" Content="Sesli ve Yanıp Sönen Acil Uyarı (Sen kapatana kadar yanıp söner ve ses çalar)" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>

                            <!-- Bilgisayar Açılışında Otomatik Başlat + Klasör Aç Butonu + Tam Konum Yolu -->
                            <Border Background="{DynamicResource CardInnerBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,8,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <CheckBox x:Name="ChkStartup" Content="Bilgisayar açılışında otomatik başlat" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Checked="ChkStartup_Changed" Unchecked="ChkStartup_Changed"/>
                                        <TextBlock x:Name="StartupPathText" Text="Konum: -" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="22,3,8,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource FluentButtonStyle}" VerticalAlignment="Center" Padding="12,6" FontSize="12" Click="OpenStartupFolderBtn_Click" ToolTip="Başlangıç kısayolunun bulunduğu klasörü Dosya Gezgini'nde açar">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 1.5,3.5 H 6 L 7.5,5.2 H 14.5 V 13 H 1.5 Z" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Klasörü Aç" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Button Style="{StaticResource FluentButtonStyle}" HorizontalAlignment="Right" Click="TestNotificationBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 8,2 A 4,4 0 0 1 12,6 V 9.5 L 13.5,11.5 H 2.5 L 4,9.5 V 6 A 4,4 0 0 1 8,2 Z M 6.5,13.2 A 1.5,1.5 0 0 0 9.5,13.2" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Seçili Bildirimleri Test Et" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Uygulama Verileri, EULA ve Sıfırlama Kartı -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Uygulama Verileri, Sözleşme (EULA) ve Sıfırlama" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                            <!-- Veri Klasörü (ayarlar.json ve eokul_data.json konumu) -->
                            <Border Background="{DynamicResource CardInnerBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Veri ve Ayar Dosyaları Klasörü (ayarlar.json / eokul_data.json)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="AppDataPathText" Text="Konum: -" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,8,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource FluentButtonStyle}" VerticalAlignment="Center" Padding="12,6" FontSize="12" Click="OpenAppDataFolderBtn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 1.5,3.5 H 6 L 7.5,5.2 H 14.5 V 13 H 1.5 Z" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Veri Klasörünü Aç" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- EULA Görüntüle ve Programı Sıfırla -->
                            <Border Background="{DynamicResource CardInnerBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Programı Sıfırla ve Yeniden Başlat" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="İşlem kayıtları (loglar) silinmez; takip edilen okullar ve EULA onayı sıfırlanarak program yeniden başlatılır." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource FluentButtonStyle}" Padding="12,7" FontSize="12" Margin="0,0,8,0" Click="ShowEulaBtn_Click" ToolTip="Kullanım Bilgilendirmesi (EULA) metnini görüntüler">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M 3.5,1.5 H 9.5 L 13,5 V 14.5 H 3.5 Z M 9,1.5 V 5.5 H 13 M 5.5,8.5 H 11 M 5.5,11.2 H 9.5" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Sözleşmeyi Oku" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DangerButtonStyle}" Padding="14,7" FontSize="12" Click="ResetAppBtn_Click" ToolTip="Logları silmeden okulları ve EULA onayını sıfırlar ve uygulamayı yeniden başlatır">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M 13.2,8 A 5.2,5.2 0 1 1 11.8,4.3 M 13.5,1.8 V 5.2 H 10.1" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Programı Sıfırla" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- AÇILIR İŞLEM KAYITLARI (LOG) PANELİ -->
        <Border x:Name="LogDrawerPanel" Grid.Row="2" Height="170" Visibility="Collapsed"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="İşlem Kayıtları" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Dosyaya Kaydet" Style="{StaticResource FluentButtonStyle}" Padding="10,3" FontSize="11.5" Margin="0,0,6,0" Click="ExportLogsBtn_Click"/>
                        <Button Content="Temizle" Style="{StaticResource FluentButtonStyle}" Padding="10,3" FontSize="11.5" Click="ClearLogsBtn_Click"/>
                    </StackPanel>
                </Grid>
                <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource CardInnerBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" FontFamily="Consolas" FontSize="12" Padding="8" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- ALT DURUM ÇUBUĞU -->
        <Border Grid.Row="3"
                Background="{DynamicResource TopBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,6">
            <Grid>
                <TextBlock x:Name="BottomStatusText" Text="Hazır" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <Button x:Name="ToggleLogBtn" Style="{StaticResource FluentButtonStyle}" HorizontalAlignment="Right" Padding="10,3" FontSize="11.5" BorderThickness="0" Click="ToggleLogBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="İşlem Kayıtları" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Path x:Name="ToggleLogChevron" Data="M 3.5,10.2 L 8,6 L 12.5,10.2" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
